# Copy to .env.local for local dev. On Vercel, set these in
# Project → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Canonical site origin — used as metadataBase for absolute OG/Twitter image
# URLs in link previews. Optional: falls back to the Vercel production domain,
# then localhost. Set this to your custom domain in production.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Daily reminder push notifications -------------------------------------
# Generate a VAPID pair once:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is safe to ship; the private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact address the push services see (mailto: or https:).
VAPID_SUBJECT=mailto:you@your-domain.com

# Service-role key (Supabase → Settings → API). Bypasses RLS — server only,
# never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret between pg_cron and /api/cron/reminders. Any long random
# string; set the same value as app.cron_secret in Postgres.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-cron-secret
